# Local development only. Replace development values before deployment.
# Postgres settings for the Docker development stack and local runs.
POSTGRES_DB=pharmacy_dev
POSTGRES_USER=pharmacy_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS and frontend API base
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://backend:8000/api

# Application metadata
PHARMACY_NAME=Community Pharmacy (Demo)
BUSINESS_TIME_ZONE=Africa/Kampala
CURRENCY_CODE=UGX

# Email (development-safe defaults)
DEFAULT_FROM_EMAIL=noreply@pharmacy.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
