# Copy this file to .env and fill in your local credentials before starting the app.
# The repository does not ship real database credentials; keep .env local and uncommitted.
DB_ENGINE=django.db.backends.mysql
DB_NAME=pharmacy_management_db
DB_USER=pharmacy_app
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=3306
PHARMACY_LEGACY_SCHEMA=false

# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS and frontend API base
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Application metadata
PHARMACY_NAME=Community Pharmacy (Demo)
BUSINESS_TIME_ZONE=Africa/Kampala
CURRENCY_CODE=UGX

# Email (development-safe defaults)
DEFAULT_FROM_EMAIL=noreply@pharmacy.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
