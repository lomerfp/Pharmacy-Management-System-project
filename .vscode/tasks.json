{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Pharmacy: Frontend dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Pharmacy: Django development server",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"runserver",
				"127.0.0.1:8000"
			],
			"options": {
				"cwd": "${workspaceFolder}/backend",
				"envFile": "${workspaceFolder}/.env"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Pharmacy: Run unit tests (SQLite only)",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"test",
				"pharmacy.tests",
				"--settings=config.test_settings",
				"-v",
				"1"
			],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"problemMatcher": []
		},
		{
			"label": "Pharmacy: Build frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"problemMatcher": [],
			"group": "build"
		}
	]
}